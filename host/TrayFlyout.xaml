<Window x:Class="Jester.Host.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jester — быстрые действия" Width="338" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="{DynamicResource FlyoutText}">
    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutText" Color="#F2F6FF" />
        <SolidColorBrush x:Key="FlyoutMuted" Color="#A8B5CB" />
        <SolidColorBrush x:Key="FlyoutEdge" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="FlyoutHover" Color="#13FFFFFF" />
        <SolidColorBrush x:Key="FlyoutSelected" Color="#27B8D4FF" />
        <SolidColorBrush x:Key="FlyoutAccent" Color="#B8D4FF" />
        <SolidColorBrush x:Key="FlyoutAccentInk" Color="#14233A" />
        <SolidColorBrush x:Key="FlyoutDanger" Color="#FFB3C2" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutHover}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FlyoutAccent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutSelected}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FlyoutEdge}" />
                                <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutHover}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FlyoutAccent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutMuted}" />
        </Style>
    </Window.Resources>
    <Border x:Name="Shell" BorderBrush="{DynamicResource FlyoutEdge}" BorderThickness="1" CornerRadius="18" Padding="9" Background="#23121B2C">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="10,7,9,13">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="JESTER" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Быстрые действия" FontSize="10" Foreground="{DynamicResource FlyoutMuted}" Margin="0,3,0,0" /></StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ActionButton}" Padding="10,5" FontSize="11" Content="Открыть ↗" Click="OnOpen" />
                </Grid>
                <Border x:Name="StatusPanel" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource FlyoutEdge}" Background="#0BFFFFFF" Padding="12,10" Margin="0,0,0,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#A4ADBC" Margin="0,0,7,0" /><TextBlock x:Name="StatusLabel" Text="Не подключено" FontSize="12" FontWeight="Medium" /></StackPanel>
                        <TextBlock x:Name="ServerLabel" Text="Сервер не выбран" Foreground="{DynamicResource FlyoutMuted}" FontSize="10" Margin="13,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="268" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ActionsRoot">
                    <Button x:Name="RunButton" Style="{StaticResource ActionButton}" Background="{DynamicResource FlyoutSelected}" BorderBrush="{DynamicResource FlyoutEdge}" Padding="12,11" Click="OnToggleCore" Margin="0,0,0,12">
                        <Grid><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" Foreground="{DynamicResource FlyoutAccent}" /><TextBlock x:Name="RunLabel" Text="Подключить" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" /></Grid>
                    </Button>
                    <TextBlock Text="РЕЖИМ ПОДКЛЮЧЕНИЯ" Foreground="{DynamicResource FlyoutMuted}" FontSize="9" Margin="10,0,0,6" />
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <ToggleButton x:Name="TunChoice" Style="{StaticResource ChoiceButton}" Content="Системный туннель" Click="OnTun" Margin="0,0,3,0" />
                        <ToggleButton x:Name="ProxyChoice" Style="{StaticResource ChoiceButton}" Content="Системный прокси" Click="OnProxy" Margin="3,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="МАРШРУТИЗАЦИЯ" Foreground="{DynamicResource FlyoutMuted}" FontSize="9" Margin="10,0,0,6" />
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <ToggleButton x:Name="RuleChoice" Style="{StaticResource ChoiceButton}" Content="По правилам" Tag="rule" Click="OnMode" />
                        <ToggleButton x:Name="GlobalChoice" Style="{StaticResource ChoiceButton}" Content="Глобально" Tag="global" Click="OnMode" />
                        <ToggleButton x:Name="DirectChoice" Style="{StaticResource ChoiceButton}" Content="Напрямую" Tag="direct" Click="OnMode" />
                    </UniformGrid>
                    <Border Height="1" Background="{DynamicResource FlyoutEdge}" Margin="10,1,10,6" />
                    <Button x:Name="RestartButton" Style="{StaticResource ActionButton}" Click="OnRestart"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" /><TextBlock Text="Перезапустить ядро" /></StackPanel></Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnCopy"><Grid><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" /><StackPanel Margin="28,0,0,0"><TextBlock Text="Скопировать адрес" /><TextBlock x:Name="PortLabel" FontSize="10" Foreground="{DynamicResource FlyoutMuted}" Margin="0,2,0,0" /></StackPanel></Grid></Button>
                    <Button Style="{StaticResource ActionButton}" Click="OnElevate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" /><TextBlock Text="Запустить от администратора" /></StackPanel></Button>
                    <Button Style="{StaticResource ActionButton}" Foreground="{DynamicResource FlyoutDanger}" Click="OnPanic"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource FlyoutDanger}" /><TextBlock Text="Экстренное отключение" /></StackPanel></Button>
                    <Border Height="1" Background="{DynamicResource FlyoutEdge}" Margin="10,6,10,5" />
                    <Button Style="{StaticResource ActionButton}" Click="OnExit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" Style="{StaticResource Glyph}" /><TextBlock Text="Выйти из Jester" /></StackPanel></Button>
                </StackPanel>
                <TextBlock x:Name="MessageLabel" Visibility="Collapsed" Foreground="{DynamicResource FlyoutMuted}" FontSize="10" TextWrapping="Wrap" Margin="11,6,11,5" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
